terraform {
  required_version = ">= 1.6"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

provider "aws" {
  region = var.aws_region

  default_tags {
    tags = {
      Project = "TD3 AWS 3-tiers"
      Owner   = var.owner
      TD      = "Jour3"
    }
  }
}
